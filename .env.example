# Puerto de la API
PORT=4000
# Conexión a Postgres (en docker-compose el host es "db")
# En producción NO puede quedar la contraseña por defecto: el arranque falla.
DATABASE_URL=postgres://portal:portal@db:5432/portal_rrhh

# ── Sesión y credenciales ────────────────────────────────────────────────────
# Secreto para firmar los JWT. En producción es OBLIGATORIO y debe ser aleatorio
# de ≥32 caracteres; si falta o es conocido, el backend no arranca.
#   Generalo con:  openssl rand -hex 32
JWT_SECRET=cambiar-este-secreto-en-produccion
# Duración de la sesión. Más corta = menos ventana útil para un token robado.
JWT_EXPIRES_IN=2h
# Orígenes permitidos para CORS, separados por coma. En producción es obligatorio
# y NO se admite "*" (dejaría que cualquier sitio consulte la API).
CORS_ORIGIN=http://localhost:5173
# Coste de bcrypt. Mínimo forzado: 12.
BCRYPT_ROUNDS=12
# ── Medidas de la auditoría 08/2026 NO desplegadas (decisión de negocio) ──────
# Están implementadas y probadas; poner true las activa sin tocar código.
#
# Política de contraseñas estricta: mínimo 10 caracteres, al menos 3 de 4 familias
# (minúsculas/mayúsculas/números/símbolos), sin contraseñas comunes y sin contener
# DNI, legajo, nombre ni mail. Apagada rige la regla anterior (ver PWD_MIN_SIMPLE).
PWD_POLITICA_ESTRICTA=false
PWD_MIN_SIMPLE=6
# Blanqueo administrativo con clave temporal aleatoria en vez de dejarla = DNI.
# El panel de administración ya muestra la clave generada cuando esto está en true.
BLANQUEO_ALEATORIO=false
# Bloqueo de cuenta por intentos fallidos (fuerza bruta dirigida a un usuario).
LOGIN_MAX_INTENTOS=8
LOGIN_BLOQUEO_MIN=15
# Cuánto puede tardar en aplicarse una revocación de sesión (caché de estado, ms).
SESION_CACHE_MS=15000

# ── Límites de tasa (pedidos por ventana; 0 = usar el valor por defecto) ──────
RATE_GENERAL=300     # por minuto y por usuario/IP, para toda la API
RATE_LOGIN=15        # por 15 minutos y por IP, en endpoints de credenciales
RATE_PESADO=30       # por minuto: reportes, liquidación, exportaciones
RATE_IA=40           # por hora y por usuario: consultas de IA (cuestan dinero)
RATE_MAIL=20         # por hora y por usuario: envíos de correo

# Confianza en el reverse proxy para leer la IP real (X-Forwarded-For).
# 1 = un proxy delante (nginx). 2 = dos (nginx + Caddy). Un valor de más
# permitiría falsear la IP y esquivar el límite de tasa.
TRUST_PROXY=1

# ── Integración Pro-Soft (Gestión de Personal) — conexión directa de fichadas ──
# Credenciales de un usuario de Pro-Soft (NO commitear las reales).
PROSOFT_USER=
PROSOFT_PASS=
PROSOFT_BASE=https://apild.azurewebsites.net/api
# Importación automática diaria del mes en curso (true/false) y hora local (0-23).
PROSOFT_AUTO=false
PROSOFT_AUTO_HORA=6

# ── Correo saliente (SMTP) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Asistencia por IA (opcional) ──
# Si no definís IA_API_KEY, las funciones de IA quedan deshabilitadas y el resto del portal funciona igual.
IA_PROVIDER=anthropic          # anthropic | openai
IA_API_KEY=                    # tu clave del proveedor
IA_MODEL=                      # opcional; por defecto claude-3-5-haiku-latest / gpt-4o-mini
IA_BASE_URL=                   # opcional; para gateways compatibles
IA_MAX_TOKENS=1200

# ── Respaldo automático de la base (pg_dump). Requiere pg_dump en el PATH ──
BACKUP_AUTO=true          # poné false para desactivar el respaldo diario
BACKUP_HORA=3             # hora del día (0-23) para el respaldo automático
BACKUP_RETENCION=14       # cuántos respaldos conservar (se borran los más viejos)
# BACKUP_DIR=             # carpeta destino (por defecto: <backend>/backups)
# IMPORTANTE: el respaldo contiene sueldos, DNI, CUIL, CBU, certificados médicos y
# hashes de contraseña. Con esta frase se cifra con AES-256-GCM antes de tocar el
# disco. Guardala fuera del servidor: sin ella el respaldo NO se puede restaurar.
BACKUP_PASSPHRASE=

# Alerta de paritaria/escala sin actualizar (meses)
PARITARIA_MESES=6

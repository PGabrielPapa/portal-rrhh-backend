# Puerto de la API
PORT=4000
# Conexión a Postgres (en docker-compose el host es "db")
DATABASE_URL=postgres://portal:portal@db:5432/portal_rrhh
# Secreto para firmar JWT (CAMBIAR en producción)
JWT_SECRET=cambiar-este-secreto-en-produccion
JWT_EXPIRES_IN=8h
# Origen permitido para CORS (front)
CORS_ORIGIN=http://localhost:5173
# Rounds de bcrypt
BCRYPT_ROUNDS=10

# ── Integración Pro-Soft (Gestión de Personal) — conexión directa de fichadas ──
# Credenciales de un usuario de Pro-Soft (NO commitear las reales).
PROSOFT_USER=
PROSOFT_PASS=
PROSOFT_BASE=https://apild.azurewebsites.net/api
# Importación automática diaria del mes en curso (true/false) y hora local (0-23).
PROSOFT_AUTO=false
PROSOFT_AUTO_HORA=6

# ── Asistencia por IA (opcional) ──
# Si no definís IA_API_KEY, las funciones de IA quedan deshabilitadas y el resto del portal funciona igual.
IA_PROVIDER=anthropic          # anthropic | openai
IA_API_KEY=                    # tu clave del proveedor
IA_MODEL=                      # opcional; por defecto claude-3-5-haiku-latest / gpt-4o-mini
IA_BASE_URL=                   # opcional; para gateways compatibles
IA_MAX_TOKENS=1200

# Respaldo automático de la base (pg_dump). Requiere pg_dump en el PATH.
BACKUP_AUTO=true          # poné false para desactivar el respaldo diario
BACKUP_HORA=3             # hora del día (0-23) para el respaldo automático
BACKUP_RETENCION=14       # cuántos respaldos conservar (se borran los más viejos)
# BACKUP_DIR=             # carpeta destino (por defecto: <backend>/backups)

# Alerta de paritaria/escala sin actualizar (meses)
PARITARIA_MESES=6

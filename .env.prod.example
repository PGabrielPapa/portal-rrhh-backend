# ── Producción — copiar a .env y completar ──
# Contraseña de Postgres (FUERTE)
POSTGRES_PASSWORD=cambiar_por_una_clave_fuerte
POSTGRES_USER=portal
POSTGRES_DB=portal_rrhh
# Secreto para firmar los JWT (largo y aleatorio). Generar con: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Origen permitido para CORS. En este setup el front pega vía proxy /api del MISMO host,
# así que dejá tu dominio público real (recomendado). Evitá '*' en producción
# (con credenciales el navegador lo rechaza y además es permisivo).
# Ej: https://rrhh.tu-dominio.com   ·   Para puro same-origin via proxy podés dejarlo vacío.
CORS_ORIGIN=https://rrhh.tu-dominio.com
# Producción (habilita el fail-fast del JWT_SECRET y trust proxy)
NODE_ENV=production
BCRYPT_ROUNDS=10

# Dominio público para HTTPS automático (Caddy/Let's Encrypt). Apuntá su registro A a la IP del droplet.
DOMAIN=rrhh.tu-dominio.com
